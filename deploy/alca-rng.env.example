# Copie para /etc/alca-rng.env (chmod 600, dono root).
PORT=4173
NEXUS_HOST=127.0.0.1
NEXUS_DB=/var/lib/alca-rng/nexus.sqlite
TRUST_PROXY=1
PUBLIC_ORIGIN=https://jogo.exemplo.com.br
# Encontros por lote na recuperação offline.
RECOVERY_BATCH=300
# OAuth (opcional). Atualize as URLs de retorno nos consoles do Google e do Discord:
#   https://jogo.exemplo.com.br/api/auth/google/callback
#   https://jogo.exemplo.com.br/api/auth/discord/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
